{
  "name": "@iyulab/declart-web",
  "version": "0.18.0",
  "description": "Declarative diagram engine for browsers and bundlers (Vite, webpack, Rollup) — declare what to show, the engine renders SVG",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/declart"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "wasm/declart_wasm.js",
    "wasm/declart_wasm.d.ts",
    "wasm/declart_wasm_bg.wasm"
  ],
  "scripts": {
    "build": "wasm-pack build ../../crates/declart-wasm --target bundler --out-dir ../../packages/declart-web/wasm"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["diagram", "svg", "wasm", "browser", "vite", "declart"]
}
